# Gateway (app/src/server.js)
PORT=18130
UI_ORIGIN=http://127.0.0.1:18132
LOG_LEVEL=info
# Optional frozen cohort file for previews using an existing database.
# TAG_RANKING_BASELINE_FILE=/absolute/path/to/ranking-baseline.json

# Own database (MariaDB in infra/compose.yml) and job queue (Redis)
TAG_DB_URL=mysql://tag_observe:CHANGE_ME@127.0.0.1:13306/tag_observe
REDIS_URL=redis://127.0.0.1:16379

# Verified nearline content cache. Without these, retention keeps local content.
# TAG_CONTENT_ARCHIVE_REMOTE=nas:Archive/tag.analysis.tw/content-v1
# TAG_CONTENT_ARCHIVE_RCLONE_CONFIG=/home/deck/.config/nas-backup/rclone.conf
# TAG_CONTENT_ARCHIVE_SPOOL=/home/deck/tag-analysis-private/content-archive-spool
# TAG_CONTENT_ARCHIVE_BATCH=5000

# Worker schedules (app/src/worker.ts); defaults shown
# RANKING_INTERVAL_MINUTES=10
# CRAWL_ENABLED=1
# CRAWL_NEWS_MINUTES=9
# CRAWL_HOURLY_MINUTES=60        # period per source (due filter)
# CRAWL_HOURLY_RUN_MINUTES=30    # how often an hourly-group run starts
# CRAWL_ARTICLES_MINUTES=19
# CRAWL_DISABLED=media1,media2
# EVENTS_CRON=4,34 * * * *

# Journalist removal requests (GitHub issues titled 記者頁移除請求：<名字>) are
# polled by the gateway; defaults shown. GITHUB_TOKEN raises the API rate limit.
# JOURNALIST_REMOVAL_SYNC=1
# JOURNALIST_REMOVAL_SYNC_MINUTES=10
# JOURNALIST_REMOVAL_REPOSITORY=skyhong2002/tag.observe.tw
# GITHUB_TOKEN=

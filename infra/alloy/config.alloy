loki.source.journal "tag" {
  path          = "/var/log/journal"
  max_age       = "24h"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.json.receiver]
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_user_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    source_labels = ["__journal__systemd_user_unit"]
    regex         = "tag-(analysis|worker)\\.service"
    action        = "keep"
  }
}

loki.process "json" {
  stage.json {
    expressions = { level = "level", msg = "msg" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:13100/loki/api/v1/push"
  }
}

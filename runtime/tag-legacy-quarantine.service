[Unit]
Description=Review and replay equivalent duplicate quarantines one package at a time

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/deck/.local/share/tag-nearline-operations/current/tools/nearline/sync-generations.py --config /home/deck/.config/tag-nearline-operations/config.json --mode replay
Environment=PATH=/home/sky/.local/node-24.15.0/bin:/home/deck/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=15
TimeoutStartSec=1h
UMask=0077
# A run that cannot get the shared lock exits 75 after writing a deferred receipt (#24).
SuccessExitStatus=75

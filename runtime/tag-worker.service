[Unit]
Description=tag.observe.tw background worker (ranking snapshots)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/deck/.local/share/tag-analysis/current
ExecStart=/home/deck/.local/bin/node app/src/worker.ts
Environment=NODE_ENV=production
Environment=PATH=/home/deck/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=WORKER_METRICS_PORT=18133
Environment=RANKING_INTERVAL_MINUTES=10
EnvironmentFile=-/home/deck/Projects/tag.analysis.tw/.env
Restart=always
RestartSec=5
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target

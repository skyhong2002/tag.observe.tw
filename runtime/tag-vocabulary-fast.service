[Unit]
Description=Ten-minute tag vocabulary changes
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
WorkingDirectory=/home/deck/.local/share/tag-analysis/current
EnvironmentFile=/home/deck/Projects/tag.analysis.tw/.env
EnvironmentFile=/home/deck/.config/tag-vocabulary-export.env
Environment=TAG_VOCABULARY_MAX_DURATION_MS=175000
ExecStart=/home/deck/.local/bin/node tools/vocabulary-export.ts --execute --fast
Restart=on-failure
RestartSec=30
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
MemoryMax=1G
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes

[Unit]
Description=Independently verify NAS legacy integration receipts against live origins
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/share/tag-legacy-import/reconcile.sh
Environment=PATH=/home/deck/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
Nice=15
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=45min

[Unit]
Description=tag.observe.tw immutable complete vocabulary export
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/deck/.local/share/tag-analysis/current
EnvironmentFile=/home/deck/.config/tag-vocabulary-export.env
ExecStart=/home/deck/.local/bin/node tools/vocabulary-export.ts --execute
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
MemoryMax=1G
TimeoutStartSec=5min
NoNewPrivileges=yes
PrivateTmp=yes

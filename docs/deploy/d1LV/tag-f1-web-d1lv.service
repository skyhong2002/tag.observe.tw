[Unit]
Description=tag F1 reviewed d1LV frontend
After=network-online.target tag-f1-api-d1lv.service
Wants=tag-f1-api-d1lv.service
[Service]
Type=simple
WorkingDirectory=/home/deck/.local/share/tag-analysis/releases/aff5c0289c4863fedb37368b4942884ccc068d77-d1LVsC3sk6p04uOyWUx5T-simple-001/web/.next/standalone/web
ExecStart=/home/deck/.local/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=18232
Environment=HOSTNAME=127.0.0.1
Environment=TAG_API_ORIGIN=http://127.0.0.1:18230
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=UV_THREADPOOL_SIZE=2
Environment=VIPS_CONCURRENCY=1
Restart=always
RestartSec=3
PrivateTmp=yes
NoNewPrivileges=yes
[Install]
WantedBy=default.target

[Unit]
Description=tag F1 d1LV loopback API for frontend data
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/home/deck/.local/share/tag-analysis/releases/aff5c0289c4863fedb37368b4942884ccc068d77-d1LVsC3sk6p04uOyWUx5T-simple-001
ExecStart=/usr/bin/env PORT=18230 UI_ORIGIN=http://127.0.0.1:18232 /home/deck/.local/bin/node app/src/server.js
Environment=NODE_ENV=production
EnvironmentFile=/home/deck/Projects/tag.analysis.tw/.env
Environment=UV_THREADPOOL_SIZE=2
Environment=VIPS_CONCURRENCY=1
Restart=always
RestartSec=3
PrivateTmp=yes
NoNewPrivileges=yes
[Install]
WantedBy=default.target

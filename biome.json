{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "app/src/**",
      "app/test/**",
      "tools/**",
      "web/src/**",
      "web/test/**",
      "*.ts",
      "*.json",
      "!app/data",
      "!app/templates",
      "!app/proofs",
      "!tests",
      "!docs",
      "!artifacts",
      "!package-lock.json",
      "!tools/f1-privacy",
      "!tools/mint-capture",
      "!tools/mint-f1-execution.js",
      "!tools/sm-f1",
      "!tools/sm-local-candidate",
      "!**/*.css"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noParameterAssign": "off",
        "useTemplate": "off",
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": []
}
